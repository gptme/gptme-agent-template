{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-hook.sh --no-block python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/match-lessons.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Bash|Grep|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-hook.sh --no-block python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/match-lessons.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-hook.sh --no-block python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-session.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
