#!/bin/bash
# git-safe-commit: Serialize git commits to prevent concurrent staging conflicts
#
# Problem: When multiple sessions (autonomous, operator, meta-operator) run
# concurrently on the same repo, they share .git/index. prek's stash/restore
# cycle during pre-commit hooks can race with concurrent commits, causing:
#   - Wrong files in commits (staged by another session)
#   - prek stash-restore conflicts that silently revert edits
#   - Wasted tokens re-doing work that was lost
#
# Solution: flock serializes the entire commit (including pre-commit hooks)
# so prek's stash/restore is atomic from other sessions' perspective.
# Implicit whole-index commits (no pathspecs) are refused so a concurrent
# session cannot pick up another session's staged files.
#
# Usage: git-safe-commit file1.py file2.py -m "feat: description"
#        (same arguments as `git commit`; pathspecs required)

set -uo pipefail

GIT_DIR="$(git rev-parse --git-dir 2>/dev/null)" || true
if [ -z "$GIT_DIR" ]; then
    echo "error: not in a git repository" >&2
    exit 1
fi

LOCKFILE="$GIT_DIR/commit.lock"

PATHSPEC_COUNT=0
SKIP_NEXT_ARG=0
PARSE_AFTER_DASHDASH=0
PATHSPEC_FILE_NEXT=0

# Exclusion-only pathspecs (e.g. :^README.md, :!foo, :(exclude)bar) don't
# positively select files — counting them would let an attacker bypass the guard
# while still committing the whole index minus a few excluded paths.
is_exclusion_only_pathspec() {
    case "$1" in
        ":(exclude"*|":!"*|":^"*) return 0 ;;
    esac
    return 1
}

for arg in "$@"; do
    if [ "$PATHSPEC_FILE_NEXT" -eq 1 ]; then
        PATHSPEC_FILE_NEXT=0
        # Only count if file has content; empty file (e.g. /dev/null) means no pathspecs
        [ -s "$arg" ] && PATHSPEC_COUNT=$((PATHSPEC_COUNT + 1))
        continue
    fi
    if [ "$SKIP_NEXT_ARG" -eq 1 ]; then
        SKIP_NEXT_ARG=0
        continue
    fi
    if [ "$PARSE_AFTER_DASHDASH" -eq 1 ]; then
        is_exclusion_only_pathspec "$arg" || PATHSPEC_COUNT=$((PATHSPEC_COUNT + 1))
        continue
    fi
    case "$arg" in
        --)
            PARSE_AFTER_DASHDASH=1
            ;;
        -m|--message|-F|--file|-c|--reedit-message|-C|--reuse-message|--fixup|--squash|--author|--date|--trailer|-t|--template|--cleanup)
            SKIP_NEXT_ARG=1
            ;;
        --pathspec-from-file)
            PATHSPEC_FILE_NEXT=1
            ;;
        --message=*|--file=*|--author=*|--date=*|--fixup=*|--squash=*|--trailer=*|--template=*|--reedit-message=*|--reuse-message=*|--cleanup=*|--gpg-sign=*)
            ;;
        --pathspec-from-file=*)
            pfile="${arg#--pathspec-from-file=}"
            [ -s "$pfile" ] && PATHSPEC_COUNT=$((PATHSPEC_COUNT + 1))
            ;;
        -*)
            ;;
        *)
            is_exclusion_only_pathspec "$arg" || PATHSPEC_COUNT=$((PATHSPEC_COUNT + 1))
            ;;
    esac
done

if [ "$PATHSPEC_COUNT" -eq 0 ]; then
    echo "Refusing implicit whole-index commit in shared repo" >&2
    echo "Use explicit file paths: git-safe-commit file1.py file2.py -m \"...\"" >&2
    exit 1
fi

# Serialize commits with 60s timeout (prek hooks can take ~30s)
exec flock --timeout 60 "$LOCKFILE" git commit "$@"
